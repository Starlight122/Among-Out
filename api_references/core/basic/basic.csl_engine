log_debug   :: proc(fmt: string, args: [^]any = {}) #foreign;
log_info    :: proc(fmt: string, args: [^]any = {}) #foreign;
log_warning :: proc(fmt: string, args: [^]any = {}) #foreign;
log_error   :: proc(fmt: string, args: [^]any = {}) #foreign;
print :: log_info;
log :: log_info;

format_string :: proc(fmt: string, args: [^]any = {}) -> string #foreign;

string_trim :: proc(str: string) -> string #foreign;
string_substring :: proc(str: string, start: int, length: int) -> string #foreign;
string_split :: proc(str: string, delimiter: string) -> []string #foreign;

Format_Int :: struct {
    // :CSLFormatInt
    v: s64;
    leading_zeroes: s64;
}

format_int :: proc(v: int, leading_zeroes: int = 0) -> Format_Int {
    result: Format_Int;
    result.v              = v;
    result.leading_zeroes = leading_zeroes;
    return result;
}

Format_Float :: struct {
    // :CSLFormatFloat
    v: f32;
    leading_zeroes: s64;
    decimals: s64;
}

format_float :: proc(v: f32, decimals: int = 6, leading_zeroes: int = 0) -> Format_Float {
    result: Format_Float;
    result.v              = v;
    result.leading_zeroes = leading_zeroes;
    result.decimals       = decimals;
    return result;
}

assert :: proc(condition: bool, fmt: string #fmt_string, args: [^]any = {}) #foreign "csl_assert";

memcpy :: proc(dst: *u8, src: *u8, count: int) #requires_unsafe #foreign "csl_memcpy";
_array_sort_f32 :: proc(data: *u8, count: int, stride: int, field_offset: int, descending: bool) #requires_unsafe #foreign "csl_array_sort_f32";

// Sort a dynamic array by an f32 field at the supplied byte offset.
array_sort :: proc(array: [..]$T, field_offset: int, descending: bool = false) {
    assert(field_offset >= 0 && field_offset + #size_of(float) <= #size_of(T),
        "array_sort field offset % is outside an element of size %.", {field_offset, #size_of(T)});
    if array.count < 2 return;
    #unsafe _array_sort_f32((&array.data.*).(*u8), array.count, #size_of(T), field_offset, descending);
}



Spatial_Hash_Point :: struct {
    id: u64;
    position: v2;
}

Spatial_Hash_Separation :: struct {
    id: u64;
    acceleration: v2;
}

_Spatial_Hash_Entry :: struct {
    point: Spatial_Hash_Point;
    cell_x: s64;
    cell_y: s64;
    previous: s64;
    next: s64;
}

_Spatial_Hash_Id_Slot :: struct {
    id: u64;
    entry_index: s64;
}

_spatial_hash_clear :: proc(buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) #foreign "csl_spatial_hash_clear";
_spatial_hash_rebuild :: proc(cell_size: float, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) #foreign "csl_spatial_hash_rebuild";
_spatial_hash_sync :: proc(cell_size: float, data: *u8, count: int, stride: int, id_offset: int, position_offset: int, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) #requires_unsafe #foreign "csl_spatial_hash_sync";
_spatial_hash_insert :: proc(cell_size: float, id: u64, position: v2, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) -> bool #foreign "csl_spatial_hash_insert";
_spatial_hash_update :: proc(cell_size: float, id: u64, position: v2, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) -> bool #foreign "csl_spatial_hash_update";
_spatial_hash_remove :: proc(id: u64, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, id_slots: ref [..]_Spatial_Hash_Id_Slot) -> bool #foreign "csl_spatial_hash_remove";
_spatial_hash_query_radius :: proc(cell_size: float, center: v2, radius: float, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, results: ref [..]Spatial_Hash_Point) #foreign "csl_spatial_hash_query_radius";
_spatial_hash_query_box :: proc(cell_size: float, min: v2, max: v2, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, results: ref [..]Spatial_Hash_Point) #foreign "csl_spatial_hash_query_box";
_spatial_hash_separation :: proc(cell_size: float, radius: float, strength: float, buckets: ref [..]s64, entries: ref [..]_Spatial_Hash_Entry, results: ref [..]Spatial_Hash_Separation) #foreign "csl_spatial_hash_separation";

Spatial_Hash :: struct {
    cell_size: float;
    _buckets: [..]s64;
    _entries: [..]_Spatial_Hash_Entry;
    _id_slots: [..]_Spatial_Hash_Id_Slot;

    _ensure_capacity :: method(min_capacity: int) {
        entry_capacity := next_power_of_two(max(min_capacity, 8));
        if _entries.capacity < entry_capacity {
            _entries.reserve(entry_capacity);
        }

        table_capacity := next_power_of_two(max(min_capacity * 2, 16));
        if _buckets.count < table_capacity {
            _buckets.reserve(table_capacity);
            _id_slots.reserve(table_capacity);
            #unsafe _buckets.count = table_capacity;
            #unsafe _id_slots.count = table_capacity;
            _spatial_hash_rebuild(cell_size, ref _buckets, ref _entries, ref _id_slots);
        }
    }

    init :: method(new_cell_size: float, initial_capacity: int = 64) {
        assert(new_cell_size > 0, "Spatial_Hash cell size must be positive; got %.", {new_cell_size});
        assert(initial_capacity >= 0, "Spatial_Hash initial capacity must not be negative; got %.", {initial_capacity});
        cell_size = new_cell_size;
        _entries.clear();
        _ensure_capacity(initial_capacity);
        _spatial_hash_clear(ref _buckets, ref _entries, ref _id_slots);
    }

    clear :: method() {
        if _buckets.count == 0 return;
        _spatial_hash_clear(ref _buckets, ref _entries, ref _id_slots);
    }

    count :: method() -> int {
        return _entries.count;
    }

    // Replaces the hash contents with the ids and positions in a struct array.
    // Existing allocations are reused.
    sync :: method(items: ref [..]$T, id_offset: int, position_offset: int) {
        assert(cell_size > 0 && _buckets.count > 0, "Spatial_Hash must be initialized before syncing.");
        assert(id_offset >= 0 && id_offset + #size_of(u64) <= #size_of(T),
            "Spatial_Hash id offset % is outside an element of size %.", {id_offset, #size_of(T)});
        assert(position_offset >= 0 && position_offset + #size_of(v2) <= #size_of(T),
            "Spatial_Hash position offset % is outside an element of size %.", {position_offset, #size_of(T)});
        _ensure_capacity(items.count);
        if items.count == 0 {
            clear();
            return;
        }
        #unsafe _spatial_hash_sync(cell_size, (&items.data.*).(*u8), items.count, #size_of(T), id_offset, position_offset, ref _buckets, ref _entries, ref _id_slots);
    }

    try_insert :: method(id: u64, position: v2) -> bool {
        assert(cell_size > 0 && _buckets.count > 0, "Spatial_Hash must be initialized before inserting.");
        _ensure_capacity(_entries.count + 1);
        return _spatial_hash_insert(cell_size, id, position, ref _buckets, ref _entries, ref _id_slots);
    }

    insert :: method(id: u64, position: v2) {
        inserted := try_insert(id, position);
        assert(inserted, "Spatial_Hash already contains id %.", {id});
    }

    update :: method(id: u64, position: v2) -> bool {
        if _buckets.count == 0 return false;
        return _spatial_hash_update(cell_size, id, position, ref _buckets, ref _entries, ref _id_slots);
    }

    remove :: method(id: u64) -> bool {
        if _buckets.count == 0 return false;
        return _spatial_hash_remove(id, ref _buckets, ref _entries, ref _id_slots);
    }

    // Results are exact, not just broadphase candidates. The output array is
    // cleared and its existing allocation is reused.
    query_radius :: method(center: v2, radius: float, results: ref [..]Spatial_Hash_Point) {
        assert(radius >= 0, "Spatial_Hash query radius must not be negative; got %.", {radius});
        results.reserve(_entries.count);
        _spatial_hash_query_radius(cell_size, center, radius, ref _buckets, ref _entries, ref results);
    }

    // Both corners may be supplied in either order.
    query_box :: method(min: v2, max: v2, results: ref [..]Spatial_Hash_Point) {
        results.reserve(_entries.count);
        _spatial_hash_query_box(cell_size, min, max, ref _buckets, ref _entries, ref results);
    }

    // Computes all pairwise separation accelerations in one native pass. There
    // is one result per point, keyed by id; the output allocation is reused.
    separation :: method(radius: float, strength: float, results: ref [..]Spatial_Hash_Separation) {
        assert(radius > 0, "Spatial_Hash separation radius must be positive; got %.", {radius});
        results.reserve(_entries.count);
        _spatial_hash_separation(cell_size, radius, strength, ref _buckets, ref _entries, ref results);
    }
}



Math :: struct {
